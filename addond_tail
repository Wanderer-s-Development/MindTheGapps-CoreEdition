EOF
}

case "$1" in
  backup)
    list_files | while read FILE DUMMY; do
      backup_file $S/$FILE
    done
  ;;
  restore)
    list_files | while read FILE REPLACEMENT; do
      R=""
      [ -n "$REPLACEMENT" ] && R="$S/$REPLACEMENT"
      [ -f "$C/$S/$FILE" ] && restore_file $S/$FILE $R
    done
  ;;
  pre-backup)
    # Stub
  ;;
  post-backup)
    # Stub
  ;;
  pre-restore)
    # Stub
  ;;
  post-restore)
    for target in \
      /product/priv-app/Dialer \
      /product/app/messaging \
      /product/app/Mms \
      /product/priv-app/Mms \
      /product/priv-app/Contacts \
      /product/app/Contacts \
      /product/etc/permissions/com.android.dialer.xml \
      /product/etc/permissions/privapp_whitelist_com.android.dialer-ext.xml \
      /product/etc/sysconfig/com.android.messaging.allowlist.xml \
      /product/etc/permissions/com.android.contacts.xml \
      /system_ext/priv-app/Provision \
      /system_ext/priv-app/LineageSetupWizard \
      /system/priv-app/Dialer \
      /system/app/messaging \
      /system/app/Mms \
      /system/app/Contacts \
      /system/priv-app/Contacts \
      /system/priv-app/Provision \
      /system/priv-app/LineageSetupWizard; do
      rm -rf "$target"
    done
    for i in $(list_files); do
      f=$(get_output_path "$S/$i")
      chown root:root $f
      chmod 644 $f
      chmod 755 $(dirname $f)
    done
  ;;
esac
